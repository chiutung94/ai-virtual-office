{
  "name": "ai-virtual-office",
  "version": "0.1.0",
  "private": true,
  "description": "AI VIRTUAL OFFICE — AI Drama Production HQ",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "google-auth-library": "9.15.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
