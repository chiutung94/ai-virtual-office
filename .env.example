# ─────────────────────────────────────────────────────────────
# AI VIRTUAL OFFICE — server-side configuration
# Copy to .env and fill in. These values are read ONLY by the
# Node server (server/). They are never sent to the browser.
# ─────────────────────────────────────────────────────────────
PORT=8787

# Google Sheets (primary production database)
# Spreadsheet ID = the long id in https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Path to the service-account JSON key downloaded from Google Cloud
# (share the sheet with its client_email as Editor). Never commit this file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=google-service-account.json
# Alternative to the key file:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Make.com — one Custom Webhook URL that receives all app events
MAKE_WEBHOOK_URL=
# Optional shared secret sent as header x-avo-signature for the scenario to verify
MAKE_WEBHOOK_SECRET=

# AI Head Writer (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Placeholders for later stages (presence is reported as "Needs Attention"
# until a verified test is implemented — never shown as Connected).
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
VOICE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
